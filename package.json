{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "description": "Human Future Hub — self-paced AI literacy course",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-secrets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs",
    "db:reset": "supabase db reset --linked",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked -f"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
