# Copy to .env.local for local development. Never commit values.
# Local dev and Vercel Preview both point at the compass-preview Supabase project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Must never appear in a NEXT_PUBLIC_ variable or in client code.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key for seat-code sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated, one entry per institution, format institution_id:CODE
# The seeded demo institution has id 00000000-0000-4000-8000-000000000001, e.g.
# ADMIN_ACCESS_CODES=00000000-0000-4000-8000-000000000001:DEMOADMIN
ADMIN_ACCESS_CODES=
